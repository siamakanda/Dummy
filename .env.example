PORTAL_BASE_URL="https://switchportal.instacall.digital"
PORTAL_USERNAME="#######"
PORTAL_PASSWORD="#######"
# Optional: force which table column holds the trunk name (header text, case-insensitive)
# TRUNK_NAME_COLUMN="Trunk Name"
# Optional: output format for the deck's effective_date (default %Y-%m-%d, ISO — what the portal uses)
# EFFECTIVE_DATE_FORMAT="%Y-%m-%d"
# Mailbox Dummy reads rate decks from (IMAP)
IMAP_HOST="imap.example.com"
IMAP_PORT="993"
IMAP_USER="dummy@example.com"
IMAP_PASSWORD="#######"
# IMAP_FOLDER="INBOX"
# IMAP_MARK_SEEN="true"   # set "false" to leave messages unread (fetch uses BODY.PEEK)
# Email understanding (M6) — any OpenAI-compatible endpoint; DeepSeek is the default
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY="sk-..."
LLM_MODEL="deepseek-chat"
# Web admin (M10) — single-admin login; set a long random SESSION_SECRET
ADMIN_USER="admin"
ADMIN_PASSWORD="#######"
SESSION_SECRET="change-me-to-a-long-random-string"
WEB_HOST="127.0.0.1"
WEB_PORT="8080"
# Logging: level, and a log file (set LOG_FILE="" to disable the file)
LOG_LEVEL="INFO"
LOG_FILE="data/dummy.log"
# Notifications (email only; console/log is always on). Leave unset to disable email.
# Port 465 uses implicit SSL; any other port uses STARTTLS (e.g. 587).
# SMTP_HOST="mail.example.com"
# SMTP_PORT="465"
# SMTP_USER="dummy@example.com"
# SMTP_PASSWORD="#######"
# SMTP_FROM="dummy@example.com"
# SMTP_TO="ops@example.com"
